# ReLaunch India — configuration
#
# Copy to .env and fill in only what you want to switch on. Every value below
# is optional: with an empty .env the whole journey runs locally, with no AWS
# account and no network. Each service is an independent switch — turning one
# on never requires turning on another.
#
#   cp .env.example .env

# ---------------------------------------------------------------- the switches
# Leave a line commented out to keep that concern local.

# RELAUNCH_STORE=dynamodb        # workflow state      (default: JSON files in .data/)
# RELAUNCH_ARTIFACTS=s3          # work artifacts      (default: files in .artifacts/)
# RELAUNCH_EVENTS=eventbridge    # job and profile events (default: in-process bus)
# RELAUNCH_MODEL=bedrock         # assistance and rubric feedback (default: heuristic)
# RELAUNCH_EMAIL=ses             # outbound email      (default: local outbox)

# ------------------------------------------------------------------ credentials
# Standard AWS SDK resolution: these, or an instance role, or ~/.aws/credentials.
# Never commit real values.

AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --------------------------------------------------------- per-service settings

# DynamoDB — one table, partition key `pk` (string), sort key `sk` (string).
# Nothing else is required; create it on-demand billing and you are done.
# DDB_TABLE_NAME=relaunch-india

# S3 — one bucket, no public access. The app writes submissions/<profile>/<task>.md
# S3_BUCKET=relaunch-india-artifacts

# EventBridge — a custom bus. Events are published to it AND handled in process,
# because the Lambda targets that would consume the bus are not deployed here.
# EVENT_BUS_NAME=relaunch-india

# Bedrock — the model must be enabled for your account in this region.
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# Rates are only used to report AI cost beside effort in the pilot report.
# BEDROCK_INPUT_USD_PER_1K=0.003
# BEDROCK_OUTPUT_USD_PER_1K=0.015

# SES — both addresses must be verified identities while the account is in the
# sandbox. SES_OVERRIDE_TO routes all mail to one verified inbox, naming the
# intended recipient in the subject line.
# SES_FROM_ADDRESS=you@example.com
# SES_OVERRIDE_TO=you@example.com

# ------------------------------------------------------------------- the app
PORT=4000
# RELAUNCH_SEED_PUBLISHED=true   # publish the seeded role at boot (hosted demos)
# RELAUNCH_DATA_DIR=.data
# RELAUNCH_ARTIFACT_DIR=.artifacts
