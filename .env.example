# Adapter selection. "local" runs with zero AWS dependencies.
RELAUNCH_BACKEND=local            # local | aws
RELAUNCH_DATA_DIR=.data
RELAUNCH_ARTIFACT_DIR=.artifacts
PORT=4000

# --- used only when RELAUNCH_BACKEND=aws ---
AWS_REGION=ap-south-1
DDB_TABLE_NAME=relaunch-india
S3_BUCKET=relaunch-india-artifacts
EVENT_BUS_NAME=relaunch-india
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0
SES_FROM_ADDRESS=no-reply@example.in
EUM_SOCIAL_PHONE_NUMBER_ID=
